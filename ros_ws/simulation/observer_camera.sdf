<?xml version="1.0"?>
<sdf version="1.9">
  <model name="surveillance_observer_camera">
    <static>true</static>
    <pose>-1.0 -1.3 1.8 0 0.26538810352587794 -0.09527381939330051</pose>
    <link name="camera_link">
      <sensor name="observer_rgb" type="camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>/surveillance/observer/image_raw</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>30</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
